.dart_tool/
.build/
.workflow/state/
*.log
.memsearch/
.kimi-code/
.specify/*
# The fleet extension set IS committed: a cloud lane's fresh clone
# must already carry speckit-bug-assess / -chore-assess / gh-triage.
!.specify/extensions/
!.specify/extensions.yml
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md

# speckit worktrees (never commit)
.worktrees/

# Agent/pipeline run artifacts — generated at runtime, never committed.
# Which .zfa/ paths are source vs generated: see CONTRIBUTING.md.
.zfa/runs/
.zfa/plans/last_run_*
.workflow/state-archive/
