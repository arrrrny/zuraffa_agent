.dart_tool/
.build/
.workflow/state/
*.log
.memsearch/
.kimi-code/
.specify/*
# The fleet extension set IS committed: a cloud lane's fresh clone
# must already carry speckit-bug-assess / -chore-assess / gh-triage.
!.specify/extensions/
!.specify/extensions.yml
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md

# speckit worktrees (never commit)
.worktrees/

# Generated API reference: `dart doc` writes doc/api/ by default and the
# docs workflow builds api/ for the Pages artifact. Neither is committed.
/doc/api/
/api/

# Agent/pipeline run artifacts — generated at runtime, never committed.
# Which .zfa/ paths are source vs generated: see CONTRIBUTING.md.
.zfa/runs/
.zfa/plans/last_run_*
.workflow/state-archive/

# Coverage artifacts (issue #113): `dart test --coverage=coverage` writes the
# raw VM coverage JSONs; format_coverage adds lcov.info. Generated per CI
# run, uploaded as artifacts, never committed.
coverage/
